# macOS
.DS_Store

# Local auxiliary notes (not part of the app; never committed)
memory/
.vercel
.env*

# Dev-only preview screenshots (SPEC deliverables) — never shipped to production
docs/*-preview/
# Visual-QA captures: the repo root IS the Pages site, so 2.5 MB of PNGs would be
# published and bloat every deploy. The measurements JSON is the committed evidence.
docs/*-visual-qa/*.png
# Misma regla para las capturas de la portada Free (Chrome y WebKit): 11,7 MB de
# PNG por pasada. Se miran, se archivan en local y lo que se commitea es la
# medición — `docs/p0-free-boundary/measurements.json`.
docs/p0-free-boundary/shots/
docs/p0-free-boundary/shots-webkit/
# Misma regla para la sonda de dos motores del cierre Workspace Premium
# (`scripts/aurix-wsfc-cover-probe.mjs`): 3 MB de PNG por pasada.
docs/wsfc-premium-cover/
# Y las de la sonda de primera pantalla útil (8 capacidades × 2 viewports).
docs/ws-firstscreen/
# Y las de «Tus planes» en el Dashboard.
docs/ws-dashboard-plans/
# Y las de la mudanza del comparador a Workspace.
docs/comparator-move/
# Y las del onboarding en el móvil (4 pasos × 2 viewports × 2 motores).
docs/onboarding-mobile/
# Y las de Intelligence en el móvil (`scripts/aurix-intelligence-mobile-probe.mjs`).
docs/intelligence-mobile/
# El markup de Intelligence que vuelca la QA visual con AURIX_INT04_DUMP=1: es
# un artefacto REGENERABLE a partir de app.js. Commitearlo sería congelar una
# copia que envejece en silencio mientras la superficie cambia.
docs/int04-visual-qa/markup-*.html

# Supabase CLI scratch state (regenerated on every `supabase projects …` call; never commit)
supabase/.temp/

# Claude Code: sólo lo LOCAL se ignora. .claude/ queda versionable a propósito
# (agents/, skills/ y demás infraestructura compartida deben poder commitearse).
.claude/settings.local.json
.claude/settings.local.json.bak-*

# M.06 — ensamblado del sitio publicable (generado en CI, nunca commiteado)
_site/
