# macOS
.DS_Store

# Local auxiliary notes (not part of the app; never committed)
memory/
.vercel
.env*

# Dev-only preview screenshots (SPEC deliverables) — never shipped to production
docs/*-preview/
# Visual-QA captures: the repo root IS the Pages site, so 2.5 MB of PNGs would be
# published and bloat every deploy. The measurements JSON is the committed evidence.
docs/*-visual-qa/*.png

# Supabase CLI scratch state (regenerated on every `supabase projects …` call; never commit)
supabase/.temp/

# Claude Code: sólo lo LOCAL se ignora. .claude/ queda versionable a propósito
# (agents/, skills/ y demás infraestructura compartida deben poder commitearse).
.claude/settings.local.json
.claude/settings.local.json.bak-*
